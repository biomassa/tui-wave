/target

# Claude Code local settings / session data
.claude/

# Agentic / working docs stay local — only README.md and CHANGELOG.md are tracked
*.md
!README.md
!CHANGELOG.md
!DOCUMENTATION.md
!THIRD_PARTY_NOTICES.md
!PRAAT-PLAN.md

# CDP CLI binaries (170+ prebuilt tools, ~200MiB)
/cdp/

# Reference PDFs from CDP, kept locally alongside the working docs above
*.pdf

# Python bytecode from the catalog converters
__pycache__/

# Local convenience wrapper for the env-gated Praat sweep (see praat::runner's
# catalog_smoke_test) — a personal shortcut, not part of the build
/run-praat-smoke-test.sh

# Tails the sweep's live log from a second terminal while it runs — same reason
/observe.sh
